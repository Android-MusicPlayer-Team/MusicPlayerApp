<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="返回"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 换皮肤 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:text="换皮肤"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/skin_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/skin_0" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:background="#C20C0C" />
        <View android:id="@+id/skin_1" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:background="#1976D2" />
        <View android:id="@+id/skin_2" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:background="#2E7D32" />
        <View android:id="@+id/skin_3" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:background="#7B1FA2" />
        <View android:id="@+id/skin_4" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginHorizontal="12dp" android:background="#F57C00" />
    </LinearLayout>

    <!-- 白天/夜间 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:text="显示模式"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode_day"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:text="白天"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mode_night"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:text="夜间"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 字体颜色 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:text="字体颜色"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/font_auto"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="跟随主题"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/font_white"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="白色"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/font_black"
            android:layout_width="80dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:gravity="center"
            android:text="黑色"
            android:textColor="#212121"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
